# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this file is not, so NEVER put a real secret here.
#
# On Vercel these all live in Project Settings -> Environment Variables
# instead. Nothing in this list should ever be committed.

# ---------------------------------------------------------------------
# Payload CMS (required — the app will not boot without these two)
# ---------------------------------------------------------------------

# Neon Postgres connection string. Copy the "pooled" connection string
# from the Neon dashboard and keep `?sslmode=require` on the end — Neon
# rejects unencrypted connections. This contains a password in the URL,
# which is the single biggest reason `.env` must stay gitignored.
# For local development a plain local Postgres works too:
#   postgresql://boidwip:password@localhost:5432/boidwip
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs Payload's auth tokens (JWTs) and encrypts stored credentials.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this later invalidates every existing admin session and breaks
# any encrypted field values, so set it once and keep it stable.
PAYLOAD_SECRET=

# ---------------------------------------------------------------------
# Cloudflare R2 (covers + PDF storage)
# ---------------------------------------------------------------------
# Leave ALL of these blank for local development: payload.config.ts then
# stores uploads on local disk, which is exactly right for the sandbox.
# PDFs are served straight from R2 in production (no proxying), and the
# `Content-Disposition: attachment` header is added by a Cloudflare
# Transform Rule on the bucket's public hostname — see README's deploy
# runbook, it is a dashboard step, not code.

# From the Cloudflare dashboard sidebar (a 32-char hex string). Used to
# build the S3 endpoint: https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# R2 -> Manage API Tokens -> Create API Token, with Object Read & Write
# scoped to just this bucket. The secret is shown exactly once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The R2 bucket name itself.
R2_BUCKET=boidwip-media

# A SECOND, PRIVATE bucket, for permission-evidence uploads only (the
# letters and emails that document a Tier C "permitted" book's licence —
# collections/EvidenceFiles.ts). Same account and same API token as
# above; a different bucket because the difference is public vs private.
#
# CREATE IT WITH NO PUBLIC ACCESS AND NO CUSTOM DOMAIN. That is the whole
# control: nothing here is ever handed out as an R2 URL, so evidence is
# reachable only through /api/evidence-files/file/<filename>, which runs
# the collection's authenticated `read` rule before it streams a byte. If
# you bind a public hostname to this bucket you have undone it. There is
# deliberately no NEXT_PUBLIC_ counterpart to the URL above.
#
# Unset is supported and means "no evidence storage": uploads fall back to
# local disk in development, and in PRODUCTION the collection refuses the
# upload with an explanation rather than writing a legal document to
# Vercel's ephemeral filesystem, where it would vanish on the next deploy.
# So: required in production if any book is Tier C, optional otherwise.
R2_EVIDENCE_BUCKET=boidwip-evidence

# Public base URL files are served from — either the r2.dev subdomain
# Cloudflare gives you, or a custom domain bound to the bucket. This is
# NEXT_PUBLIC_ because <Image> needs it in the browser, and its hostname
# must also be added to `images.remotePatterns` in next.config.mjs.
# No trailing slash.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, JSON-LD,
# sitemap, RSS, and Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://boidwip.com

# Shared secret for /api/cron/rebuild, compared with timingSafeEqual.
# Vercel Cron sends it as `Authorization: Bearer <secret>` once a day (see
# vercel.json). Generate the same way as PAYLOAD_SECRET. If unset, the
# route refuses every request rather than running unauthenticated.
#
# WHY A DAILY CRON EXISTS AT ALL: this site is a build artefact. A book
# whose publishDate is next Tuesday is already published in the CMS and
# still correctly hidden by lib/data.ts's date filter — and nothing
# rebuilds on its own just because a clock moved. The cron is what brings
# it live on the day. It also retries a deployment that a failed publish
# left owed, and prunes expired rows from `payload_kv`.
CRON_SECRET=

# The deployment this project publishes WITH. Vercel -> Project Settings
# -> Git -> Deploy Hooks -> create one for the production branch, then
# paste the URL here. Every publish, unpublish, delete and settings change
# POSTs it (debounced ~90s, see lib/payload/revalidate.ts), because on a
# statically generated site "publish" and "deploy" are the same event.
#
# TREAT THIS AS A CREDENTIAL, not a URL. It carries its own token and
# anyone holding it can trigger unlimited builds — which is why nothing in
# this codebase ever logs it, not even inside an error message.
#
# Unset is a supported state and it is what local development uses: every
# publish then logs "VERCEL_DEPLOY_HOOK_URL is not set" and continues, so
# the CMS is fully usable with no deploy target. On the deployed site,
# leaving it unset means edits never reach visitors.
VERCEL_DEPLOY_HOOK_URL=

# ---------------------------------------------------------------------
# Rokomari affiliate (the site's revenue layer)
# ---------------------------------------------------------------------
# All three are NEXT_PUBLIC_ on purpose: they end up in every rendered
# buy link anyway, so there is nothing to hide. Books store the PLAIN
# Rokomari product URL; lib/affiliate.ts appends these at render time,
# which is what lets the whole program be re-negotiated (or a second
# affiliate program added) without touching a single book record.
#
# affId — your Rokomari affiliate identifier.
NEXT_PUBLIC_ROKOMARI_AFFILIATE_ID=
# affs — the numeric affiliate source id Rokomari issued alongside it.
NEXT_PUBLIC_ROKOMARI_AFFILIATE_AFFS=
# cma — cookie max-age in seconds. Rokomari's program uses a 7-day
# cookie: 604800.
NEXT_PUBLIC_ROKOMARI_AFFILIATE_CMA=604800

# ---------------------------------------------------------------------
# Optional integrations (each feature silently disables itself if unset)
# ---------------------------------------------------------------------

# Reviews (built-in, DB-backed). Cloudflare Turnstile keys protect the
# public review form. Set BOTH as a pair, or leave both blank to run the
# form unprotected (it still goes through manual moderation either way).
# Site key is public; secret key must stay server-side. Use an INVISIBLE
# widget for this key so readers are not asked to click a checkbox.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin login challenge. A SEPARATE Turnstile key pair, because one key has a
# single widget mode and login wants a visible "Managed" checkbox while the
# review key above is invisible. Set BOTH to turn the login gate on; leave
# both blank and the login page is unchanged. If only one is set the gate
# stays OFF on purpose, so a half-configuration can never lock you out. If
# these are blank the login falls back to the review pair above.
#
# ONE THING TO CHECK AFTER SETTING THEM: open /admin in a private window and
# confirm the checkbox actually appears. Once both are set the server refuses
# every login without a solved challenge, so a widget that cannot draw is a
# lockout. The commonest cause is this hostname missing from the widget's
# "Domains" list in the Turnstile dashboard (localhost included, for local
# work). The login page says so on screen instead of showing a blank gap,
# and the way out is to clear TURNSTILE_LOGIN_SECRET_KEY (and
# TURNSTILE_SECRET_KEY), which switches the gate off with no code change.
NEXT_PUBLIC_TURNSTILE_LOGIN_SITE_KEY=
TURNSTILE_LOGIN_SECRET_KEY=

# Search-console ownership verification meta tags.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------
# Outbound email (admin "Forgot password" — optional, but read the note)
# ---------------------------------------------------------------------
# Three providers, any one is enough, and the precedence is
# SMTP_* > BREVO_* > GMAIL_*, so the most specific statement of intent wins and
# a move between them is "add variables" rather than a swap. With NONE set the
# forgot-password screen refuses with an explanation instead of pretending to
# send: Payload's fallback adapter reports success and writes the reset link to
# a server log only, which is worse than a visible failure. A locked-out admin
# then has to be reset by another admin. See lib/payload/email.ts.

# --- Option A: any SMTP server (use this for a mailbox on your own domain) ---
# The branch to use for a registrar/cPanel mailbox, Zoho, Hostinger, Mailgun,
# Postmark, SES, or anything else speaking SMTP.
#
# READ THIS IF YOU OWN A DOMAIN. The GMAIL_* pair below does NOT cover
# "an address at my own domain". It hardcodes smtp.gmail.com, and Gmail's SMTP
# authenticates against a GOOGLE ACCOUNT, so GMAIL_USER has to be a @gmail.com
# address or a Google Workspace address on a domain Google actually hosts. Point
# it at you@yourdomain.com from any other host and Google answers
#     535-5.7.8 Username and Password not accepted ... BadCredentials
# which reads exactly like a wrong App Password but is not: the credential was
# right, the SERVER was wrong. Put that mailbox here instead, with your own
# provider's host.
#
# All four of HOST/USER/PASSWORD and EMAIL_FROM_ADDRESS are required or this
# block counts as unconfigured and falls through, rather than becoming a
# silently broken upgrade. SMTP_PORT defaults to 587. Whitespace in
# SMTP_PASSWORD is stripped, like the Gmail App Password below.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Optional override for the TLS mode. Left blank it is derived from the port:
# 465 means implicit TLS, anything else means mandatory STARTTLS. Set to true
# or false only for a server that disagrees; getting this pair wrong hangs the
# handshake rather than erroring.
SMTP_SECURE=

# --- Option B: Brevo SMTP ---
# Brevo -> SMTP & API -> SMTP. The login is an issued identifier like
# 9a1b2c001@smtp-brevo.com and is NOT a mailbox, which is why Brevo also needs
# EMAIL_FROM_ADDRESS below. All three must be set or the Brevo block is treated
# as unconfigured and Gmail is used instead, so a half-finished cutover cannot
# silently break reset mail.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# --- Option C: Gmail App Password (zero setup, @gmail.com accounts only) ---
# Requires 2-Step Verification on the account, then
# https://myaccount.google.com/apppasswords -> create one for "Mail".
# NOT the account's normal password: an App Password is a 16-character
# mail-only credential that can be revoked on its own. Google displays it as
# four groups of four; pasting it with the spaces in is fine, they are
# stripped. Mail is always sent AS this address (Gmail rejects any other
# sender), so EMAIL_FROM_ADDRESS below is ignored on this path.
# Ceiling is roughly 500 messages a day, which is thousands more than a
# password-reset flow will ever need.
# GMAIL_USER must be @gmail.com, @googlemail.com, or a Google Workspace domain.
# Anything else is the 535 described under Option A; the app warns about it at
# boot rather than leaving you to guess.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The visible From address. REQUIRED for the SMTP and Brevo options above, and
# it must be a sender that server will accept, otherwise it answers 550 and the
# failure shows up only in the server log. Ignored when sending through Gmail.
EMAIL_FROM_ADDRESS=

# The visible From name. Optional; defaults to বইদ্বীপ.
EMAIL_FROM_NAME=

# ---------------------------------------------------------------------
# AI assistant in the admin (optional, later phase)
# ---------------------------------------------------------------------
# Set ONE of the two keys below and the editorial assistant appears in
# the admin. With neither, the panel explains that it is switched off and
# everything else works exactly as before. Both are server-only: they are
# read in lib/ai/provider.ts and never reach the browser, which is why
# neither is NEXT_PUBLIC_.
#
# The endpoints behind these require an admin session and only accept
# fixed action names — editors never send a prompt — so a leaked key is
# the only way this becomes someone else's bill. Treat these like
# PAYLOAD_SECRET.

# Google AI Studio -> Get API key. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq Console -> API Keys. https://console.groq.com/keys
GROQ_API_KEY=

# Which one to use when both keys are set: `gemini` or `groq`. Unset
# means Gemini, whose Bengali holds together better over a long answer.
# An explicit choice whose key is missing disables the feature rather
# than falling back, so a typo here is visible instead of silently
# switching models.
AI_PROVIDER=

# Model overrides. Both have working defaults; leave empty unless a model
# is retired or you want to test another one.
GEMINI_MODEL=
GROQ_MODEL=

# ---------------------------------------------------------------------
# AI cover images (Cloudflare Workers AI, optional, later phase)
# ---------------------------------------------------------------------
# Generates a placeholder cover for public-domain books that have none.
# Set the token below to enable; leave it blank and the feature explains
# it is off. Independent of the GEMINI/GROQ keys above — different
# provider for a different job (an image, not text).
#
# A SEPARATE credential from the R2 key pair: R2 keys are S3 credentials
# scoped to a bucket and cannot call the AI API. Create a Cloudflare API
# token with the "Workers AI" permission. Server-only, never NEXT_PUBLIC_.
CLOUDFLARE_AI_API_TOKEN=

# The Cloudflare account id. Optional: falls back to R2_ACCOUNT_ID, which
# is the same account for almost everyone.
CLOUDFLARE_ACCOUNT_ID=

# Model override. Defaults to @cf/black-forest-labs/flux-1-schnell.
CLOUDFLARE_AI_IMAGE_MODEL=
